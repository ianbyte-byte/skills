{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "conformance-helper": {
      "type": "stdio",
      "command": "./bin/conformance-helper.sh",
      "args": [
        "--plugin-root",
        "${PLUGIN_ROOT}",
        "--data",
        "${PLUGIN_DATA}/conformance"
      ],
      "env": {
        "LOG_LEVEL": "info"
      },
      "cwd": "${PLUGIN_ROOT}"
    },
    "registry-example": {
      "type": "streamable-http",
      "url": "https://registry.example.com/mcp",
      "headers": {
        "Accept": "application/json"
      }
    }
  }
}
